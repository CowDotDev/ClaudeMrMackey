# Discord application (use the separate TEST application/server for local dev,
# never the production one). Test application ID: 548629922457976833
# Get the bot token from the Discord Developer Portal > your test app > Bot > Reset Token.
# Never paste this value into chat/commits - only ever into this local .env file.
DISCORD_BOT_TOKEN=

# Fastify health-check / webhook server
PORT=3000

# Postgres connection string (docker-compose Postgres for local dev: `docker compose up -d`)
DATABASE_URL=postgresql://mrmackey:mrmackey@localhost:5432/mrmackey

# Claude API key used for feature-request triage
ANTHROPIC_API_KEY=

# Discord user ID allowed to approve feature requests - match by ID, never username.
APPROVER_DISCORD_USER_ID=367110412975734795

# Discord forum channel ID that acts as the feature-request board
FEATURE_REQUEST_CHANNEL_ID=

# --- Added in later phases, listed here so the shape is known up front ---

# Fine-grained GitHub PAT scoped to this repo, used to fire repository_dispatch
# GITHUB_TOKEN=
# GITHUB_REPO=CowDotDev/ClaudeMrMackey

# Only needed if/when we move to HTTP-based interactions instead of the Gateway;
# copy the exact value from the Developer Portal when it's actually wired up.
# DISCORD_PUBLIC_KEY=
